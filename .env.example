# Server Configuration
PORT=5001
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Gemini AI API Key (Required for Live LLM Classification, Deadlines & Digest Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_or_openai_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Local AES-256-GCM Vault Key (Optional: 32+ chars; auto-generates server/data/.keystore if blank)
TOKEN_ENCRYPTION_KEY=

# Supabase Credentials (leave blank to use built-in persistent local JSON store in server/data/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth & Gmail API (Optional: for OAuth sync with Gmail / Google Workspace emails)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Microsoft OAuth & Outlook/M365 Graph API (Optional: for @outlook.com, @hotmail.com, @live.com & college M365)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback

# Inbound Email Forwarding Webhook Secret (Optional: for auto-forwarding from any email provider)
INBOUND_WEBHOOK_SECRET=

# Frontend Deploy Readiness (set in client/.env or frontend host for production; leave blank in dev for Vite proxy)
VITE_API_URL=
