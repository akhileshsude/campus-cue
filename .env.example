# Server Configuration
PORT=5001
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Gemini AI API Key (Required for AI Classification, Deadlines & Digest Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_or_openai_api_key

# Supabase Credentials (leave blank to run in mock/sample-data mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth & Gmail API (Optional: for live Gmail inbox sync)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Frontend Deploy Readiness (leave blank in dev to use Vite proxy)
VITE_API_URL=
