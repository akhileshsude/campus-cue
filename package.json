{
  "name": "campus-cue-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test:ai": "npm --prefix server run test:ai",
    "test:digest": "npm --prefix server run test:digest",
    "test:college": "npm --prefix server run test:college",
    "test:eml": "npm --prefix server run test:eml",
    "test:endpoints": "npm --prefix server run test:endpoints",
    "test:http": "npm --prefix server run test:http",
    "test:user": "npm --prefix client run test:user",
    "test:all": "npm run test:college && npm run test:ai && npm run test:digest && npm run test:eml && npm run test:endpoints && npm run test:http && npm run test:user",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
